{
  "name": "farmshift-nepal",
  "private": true,
  "version": "1.0.0",
  "description": "An open-source agricultural intelligence platform combining NASA Earth observations, numerical weather models, and crop rotation heuristics for Nepal.",
  "author": "Pratik Pokhrel (https://github.com/Spongly)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Spongly/farmshift.git"
  },
  "keywords": [
    "agriculture",
    "climate-tech",
    "nasa-space-apps",
    "earth-observation",
    "geospatial",
    "agritech",
    "crop-rotation",
    "nepal"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^2.1.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.0.1",
    "vitest": "^2.1.4"
  }
}
